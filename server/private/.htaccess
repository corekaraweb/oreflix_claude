# Defense in depth: this directory should ideally live OUTSIDE the web
# root entirely (see server/README.md). If your hosting forces everything
# into one public folder, this blocks direct HTTP access to it.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
